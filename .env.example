# ==============================================================================
# Spain Pool Predictive Maintenance & Dosing System (v6.0) Environment Config
# ==============================================================================

# Database Connection (PostgreSQL 16)
DATABASE_URL=postgresql://pool:pool_secret@localhost:5432/pool_db

# Security & Ingestion Authentication Tokens (Optional)
INGESTION_TOKEN=secret-ingest-token-123
ADMIN_TOKEN=secret-admin-token-456
CORS_ORIGINS=*

# Background Scheduler & Retraining
ENABLE_SCHEDULER=true
WEATHER_REFRESH_CRON="0 4 * * *"
RETRAIN_CRON="0 3 * * 1"
RETRAIN_MIN_NEW_READINGS=200
RETRAIN_TIMEOUT_SECONDS=900

# Weather Station Coordinates (Alicante, Spain)
WEATHER_LAT=38.3452
WEATHER_LON=-0.4815
WEATHER_TZ="Europe/Madrid"

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
