FROM python:3.12-slim

WORKDIR /app

# System dependencies for XGBoost (OpenMP), PostgreSQL (libpq), and Node (for Prisma engine if needed)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 curl libpq-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Python requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source & Prisma schema
COPY prisma ./prisma
COPY ml ./ml
COPY backend ./backend
COPY data ./data
COPY models ./models
COPY outputs ./outputs
COPY fetch_weather.py inference.py pipeline_v6.py .

# Generate Prisma Client Python
RUN prisma generate

# Create non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
